{
	"name": "ordex",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/start-production.mjs",
		"start:web": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
		"start:whatsapp": "bun run src/workers/whatsapp-group/index.ts",
		"test": "vitest run",
		"lint": "biome check --write --no-errors-on-unmatched --error-on-warnings --files-ignore-unknown=true --unsafe",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --import tsx src/db/seed.ts",
		"tunnel": "ngrok http 3000",
		"whatsapp:start": "pnpm start:whatsapp",
		"whatsapp:dev": "bun run --watch src/workers/whatsapp-group/index.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.78.0",
		"@heroui/react": "^2.8.9",
		"@tailwindcss/cli": "^4.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "^0.7.0",
		"@tanstack/react-router": "^1.132.0",
		"@tanstack/react-router-devtools": "^1.132.0",
		"@tanstack/react-router-ssr-query": "^1.131.7",
		"@tanstack/react-start": "^1.132.0",
		"@tanstack/router-plugin": "^1.132.0",
		"better-sqlite3": "^12.6.2",
		"drizzle-orm": "^0.45.1",
		"framer-motion": "^12.34.4",
		"lucide-react": "^0.545.0",
		"nitro": "npm:nitro-nightly@latest",
		"qrcode-terminal": "^0.12.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"vite-tsconfig-paths": "^5.1.4",
		"whatsapp-web.js": "^1.34.7",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/devtools-vite": "^0.3.11",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.2.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.10.2",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.4",
		"drizzle-kit": "^0.31.9",
		"jsdom": "^27.0.0",
		"lefthook": "^2.1.2",
		"ngrok": "5.0.0-beta.2",
		"puppeteer": "^24.42.0",
		"tsx": "4.21.0",
		"typescript": "^5.7.2",
		"vite": "^7.1.7",
		"vitest": "^3.0.5"
	}
}
